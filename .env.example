# Copy to .env for local dev. In production these are platform environment
# variables; ANTHROPIC_API_KEY in particular must never be in the repo.

# --- required: the service refuses to start without these -------------------
# Repo prefixes permitted to emit, normalised as host/owner/... and lowercased.
# Empty means nothing emits, which is why it is fatal rather than a default.
MARIO_ALLOWED_REPOS=github.com/acme,gitlab.com/acme

# Cloudflare Access, from the BROWSER application — not the /a bypass app,
# which has its own AUD tag.
MARIO_ACCESS_TEAM_DOMAIN=acme.cloudflareaccess.com
MARIO_ACCESS_AUD=

# --- required in practice ---------------------------------------------------
# Absent: the fold is skipped every cycle and events accumulate unfolded.
ANTHROPIC_API_KEY=

# Absent: nobody can trigger a manual fold or reach any admin route.
MARIO_ADMINS=you@acme.com

# --- deployment -------------------------------------------------------------
NODE_ENV=production
PORT=8787
# Must be on the mounted volume. The code default is a RELATIVE path.
MARIO_DB=/data/mario.db

# --- tuning (defaults are fine) ---------------------------------------------
# MARIO_DECAY_MINUTES=120
# MARIO_STATE_MAX_LINES=15
# MARIO_MAX_SUMMARY=280
# MARIO_MAX_FOLD_EVENTS=500
# MARIO_FOLD_MODEL=claude-opus-5
# MARIO_HOOK_TIMEOUT_MS=250

# LOCAL DEVELOPMENT ONLY. Setting this disables browser authentication
# outright; preflight() makes it fatal when NODE_ENV=production.
# MARIO_DEV_ACTOR=you@acme.com
